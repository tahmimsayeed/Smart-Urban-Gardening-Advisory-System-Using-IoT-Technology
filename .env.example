# .env.example -- copy this to a file named ".env" and fill in your own
# values. ".env" itself is excluded from version control (see .gitignore)
# so your real key never gets shared or committed accidentally.

OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# Optional overrides:
# DEFAULT_WEATHER_LOCATION=Dhaka,BD
# SECRET_KEY=change-me-to-something-random
